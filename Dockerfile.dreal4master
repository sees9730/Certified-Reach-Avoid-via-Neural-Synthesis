FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
WORKDIR /workspace

# UTF-8 to avoid setup.py ascii decode issues
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Copy dReal source and build/install it
COPY third_party/dreal4-master /tmp/dreal4
RUN if [ "${TARGETARCH}" != "amd64" ]; then \
      echo "This Dockerfile builds dReal using ubuntu20 install scripts that require amd64."; \
      echo "Build with: docker buildx build --platform linux/amd64 ..."; \
      exit 1; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       software-properties-common gnupg2 dirmngr ca-certificates wget curl \
       apt-utils python3-dev python3-wheel python3-setuptools python3-pip python-is-python3 git graphviz \
    && for i in 1 2 3 4 5; do \
         yes "Y" | /tmp/dreal4/setup/ubuntu/20.04/install_prereqs.sh && break; \
         echo "install_prereqs failed attempt $i retrying"; \
         sleep 30; \
       done \
    && cd /tmp/dreal4 \
    && for i in 1 2 3 4 5; do \
         bazel build --jobs=2 --local_ram_resources=4096 --experimental_repository_downloader_retries=8 //:archive && break; \
         echo "bazel build failed attempt $i retrying"; \
         sleep 30; \
       done \
    && tar xfz bazel-bin/archive.tar.gz --strip-components 3 -C /usr \
    && for i in 1 2 3 4 5; do \
         bazel build --jobs=2 --local_ram_resources=4096 --experimental_repository_downloader_retries=8 //dreal:_dreal_py.so && break; \
         echo "bazel pybind build failed attempt $i retrying"; \
         sleep 30; \
       done \
    && python3 setup.py bdist_wheel \
    && pip3 install ./dist/dreal-*.whl \
    && bazel clean --expunge \
    && rm -rf /root/.cache/bazel /tmp/dreal4 /var/lib/apt/lists/* \
    && apt-get clean all

# Copy your repo and install runtime deps only (avoid dev/lint pins in requirements.txt).
COPY . /workspace
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir \
       "numpy==1.24.4" \
       "scipy==1.10.1" \
       "torch==2.3.1" \
       "torchvision==0.18.1" \
       "matplotlib==3.7.5" \
       "pandas==2.0.3" \
       "seaborn==0.13.2" \
       "sympy==1.13.3" \
       "scikit-learn==1.3.2" \
       "tqdm==4.67.1" \
       "PyYAML==6.0.3" \
       "networkx==3.1" \
       "graphviz==0.20.3" \
       "auto_LiRPA @ git+https://github.com/Verified-Intelligence/alpha-beta-CROWN.git@474f75de70160b19302795a6efe1717ec33d83ac#subdirectory=auto_LiRPA"

CMD ["python3", "-c", "import dreal; print('dreal ready'); print('run: python3 examples/synthesis/inv_pend_syn/main.py --train 1')"]
